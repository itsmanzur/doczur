{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "itsdz/glossary",
  "version": "0.1.0",
  "title": "Doczur Glossary",
  "category": "widgets",
  "icon": "book-alt",
  "description": "Display every glossary term with its definition, sorted alphabetically.",
  "keywords": [ "glossary", "terms", "definitions", "dictionary", "doczur" ],
  "supports": {
    "html": false,
    "color": false,
    "spacing": { "margin": true, "padding": true }
  },
  "attributes": {
    "heading": {
      "type": "string",
      "default": ""
    },
    "show_aliases": {
      "type": "boolean",
      "default": true
    }
  },
  "editorScript": "itsdz-blocks",
  "style": "itsdz-frontend",
  "render": "file:./render.php",
  "textdomain": "doczur"
}
